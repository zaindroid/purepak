# Xcode project is generated from project.yml by XcodeGen — never commit it,
# regenerate with `xcodegen generate` instead (see README)
*.xcodeproj/
*.xcworkspace/

# build output
build/
DerivedData/
*.ipa
*.dSYM.zip
*.dSYM

# Firebase/Google config is per-environment and carries real identifiers —
# each developer/CI drops in their own, see GoogleService-Info.plist.example
PurePak/GoogleService-Info.plist

# APNs auth key (real private key, downloadable exactly once from Apple) —
# this only ever goes to Firebase Console (Cloud Messaging config), never
# into git or CI
*.p8

# Swift Package Manager
.build/
.swiftpm/

# macOS
.DS_Store
